[ext_resource type="Script" path="res://game/features/fog_of_war/fog_of_war.gd" id="1_fog"]

[sub_resource type="Shader" id="Shader_fog"]
code = "shader_type canvas_item;\n\nconst int MAX_ROOM_RECTS = 64;\nuniform vec2 viewport_size = vec2(1280.0, 720.0);\nuniform vec2 focus_position = vec2(640.0, 360.0);\nuniform vec2 facing_direction = vec2(1.0, 0.0);\nuniform int visibility_mode = 0;\nuniform float corridor_near_radius = 170.0;\nuniform float corridor_forward_distance = 780.0;\nuniform float corridor_half_angle_radians = 1.0821;\nuniform float corridor_angle_softness_radians = 0.2094;\nuniform float corridor_distance_softness = 130.0;\nuniform float room_edge_softness = 18.0;\nuniform vec4 active_room_rect = vec4(0.0);\nuniform int room_count = 0;\nuniform vec4 room_rects[MAX_ROOM_RECTS];\nuniform vec4 fog_color : source_color = vec4(0.008, 0.014, 0.025, 0.97);\n\nfloat soft_rect_visibility(vec2 point, vec4 rect, float softness) {\n\tfloat signed_edge = min(min(point.x - rect.x, rect.z - point.x), min(point.y - rect.y, rect.w - point.y));\n\treturn smoothstep(-softness, max(1.0, softness), signed_edge);\n}\n\nfloat room_block_mask(vec2 point) {\n\tfloat blocked = 0.0;\n\tfor (int index = 0; index < MAX_ROOM_RECTS; index++) {\n\t\tif (index >= room_count) {\n\t\t\tbreak;\n\t\t}\n\t\tvec4 rect = room_rects[index];\n\t\tfloat inside = step(rect.x, point.x) * step(point.x, rect.z) * step(rect.y, point.y) * step(point.y, rect.w);\n\t\tblocked = max(blocked, inside);\n\t}\n\treturn blocked;\n}\n\nfloat corridor_visibility(vec2 pixel_position) {\n\tvec2 delta = pixel_position - focus_position;\n\tfloat radial_distance = length(delta);\n\tvec2 direction_to_pixel = radial_distance > 0.001 ? delta / radial_distance : facing_direction;\n\tfloat facing_dot = dot(direction_to_pixel, normalize(facing_direction));\n\tfloat outer_angle = corridor_half_angle_radians + corridor_angle_softness_radians;\n\tfloat cone = smoothstep(cos(outer_angle), cos(corridor_half_angle_radians), facing_dot);\n\tfloat forward = dot(delta, normalize(facing_direction));\n\tfloat in_front = smoothstep(-24.0, 48.0, forward);\n\tfloat distance_visibility = 1.0 - smoothstep(max(0.0, corridor_forward_distance - corridor_distance_softness), corridor_forward_distance, radial_distance);\n\tfloat near_visibility = 1.0 - smoothstep(corridor_near_radius * 0.62, corridor_near_radius, radial_distance);\n\tfloat visibility = max(near_visibility, cone * in_front * distance_visibility);\n\treturn visibility * (1.0 - room_block_mask(pixel_position));\n}\n\nvoid fragment() {\n\tvec2 pixel_position = UV * viewport_size;\n\tfloat visibility = visibility_mode == 1\n\t\t? soft_rect_visibility(pixel_position, active_room_rect, room_edge_softness)\n\t\t: corridor_visibility(pixel_position);\n\tCOLOR = vec4(fog_color.rgb, fog_color.a * (1.0 - clamp(visibility, 0.0, 1.0)));\n}\n"

