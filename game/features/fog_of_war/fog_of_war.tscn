[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://game/features/fog_of_war/fog_of_war.gd" id="1_fog"]

[sub_resource type="Shader" id="Shader_fog"]
code = "shader_type canvas_item;\n\nuniform vec2 viewport_size = vec2(1280.0, 720.0);\nuniform vec2 focus_position = vec2(640.0, 360.0);\nuniform float vision_radius = 410.0;\nuniform float edge_softness = 150.0;\nuniform vec4 fog_color : source_color = vec4(0.008, 0.014, 0.025, 0.94);\n\nvoid fragment() {\n\tvec2 pixel_position = UV * viewport_size;\n\tfloat distance_to_actor = distance(pixel_position, focus_position);\n\tfloat inner_radius = max(0.0, vision_radius - edge_softness);\n\tfloat fog_amount = smoothstep(inner_radius, vision_radius, distance_to_actor);\n\tfloat near_haze = smoothstep(vision_radius * 0.35, inner_radius, distance_to_actor) * 0.12;\n\tCOLOR = vec4(fog_color.rgb, fog_color.a * clamp(fog_amount + near_haze, 0.0, 1.0));\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_fog"]
shader = SubResource("Shader_fog")

[node name="BattlefieldFogOfWar" type="CanvasLayer"]
