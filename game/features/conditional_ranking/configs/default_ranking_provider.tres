[gd_resource type="Resource" script_class="RankingProviderConfig" load_steps=4 format=3]

[ext_resource type="Script" path="res://game/features/conditional_ranking/ranking_provider_config.gd" id="1_config"]
[ext_resource type="Resource" path="res://game/features/conditional_ranking/configs/default_season_policy.tres" id="2_season"]
[ext_resource type="Resource" path="res://game/features/conditional_ranking/data/season_reward_payload.tres" id="3_rewards"]

[resource]
script = ExtResource("1_config")
provider_mode = "auto"
offline_fallback_enabled = true
online_provider_label = "SFH 온라인 랭킹"
submission_build_id = "0.1.0-prototype"
maximum_pending_submissions = 64
maximum_submission_attempts = 5
submissions_per_retry = 8
season_policy = ExtResource("2_season")
season_rewards_enabled = true
reward_csv_payload = ExtResource("3_rewards")
reward_live_url = "https://docs.google.com/spreadsheets/d/1dtQKVZiMf7VRFWrVnaL3BqzR0g4ZgEG6ueH9RIN3xqM/gviz/tq?tqx=out:csv&headers=1&sheet=SeasonReward"
