[gd_resource type="Resource" script_class="ItemQualityCatalog" load_steps=6 format=3]

[ext_resource type="Script" path="res://game/features/p5_hub_progression/item_quality_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://game/features/p5_hub_progression/item_quality_definition.gd" id="2_definition"]

[sub_resource type="Resource" id="QualityDamaged"]
script = ExtResource("2_definition")
