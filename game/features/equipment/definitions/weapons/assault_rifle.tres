[gd_resource type="Resource" script_class="EquipmentWeaponDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://game/features/equipment/weapon_definition.gd" id="1_weapon"]
[ext_resource type="Script" path="res://game/features/equipment/weapon_tag_profile.gd" id="2_tags"]
[ext_resource type="Script" path="res://game/features/equipment/weapon_innate_skill_definition.gd" id="3_innate"]
[ext_resource type="Script" path="res://game/features/equipment/equipment_fixed_option.gd" id="4_option"]

[sub_resource type="Resource" id="TagProfile"]
script = ExtResource("2_tags")
major_tag = &"ranged"
middle_tag = &"firearm"
minor_tag = &"rifle"
major_label = "원거리"
middle_label = "화기"
minor_label = "소총"

[sub_resource type="Resource" id="InnateSkill"]
script = ExtResource("3_innate")
skill_id = &"capacitor_echo"
display_name = "축전 반향"
trigger_every_hits = 3
fixed_damage = 1.5
impact_strength = 1.15
effect_color = Color(0.00784314, 0.898039, 0.882353, 1)
description = "세 번째 명중마다 성장 배율을 받지 않는 고정 전격 피해를 추가합니다."

[sub_resource type="Resource" id="FixedOption"]
script = ExtResource("4_option")
option_id = &"stabilized_barrel"
display_name = "안정화 강선"
target_kind = 1
modifier_id = &"damage_multiply"
operation = 1
amount = 1.06
description = "장비 정체성에 귀속된 고정 피해 보정입니다."

[resource]
script = ExtResource("1_weapon")
weapon_id = &"assault_rifle"
display_name = "돌격소총"
tags = SubResource("TagProfile")
combat_tags = [&"projectile", &"element", &"electric"]
grade = 2
skill_mechanic_overrides = {&"magnetic_field": {&"applied_status_id": &"shock", &"radius_multiplier": 1.2, &"status_duration": 4.0, &"tick_damage_multiplier": 1.1}}
innate_skill = SubResource("InnateSkill")
fixed_options = [SubResource("FixedOption")]
maximum_level = 3
module_slot_limit = 3
module_cost_limit = 8
part_socket_ids = [&"optic", &"muzzle", &"magazine"]
description = "세 번째 명중마다 전격을 더하는 돌격소총. 광학·총구·탄창 파츠를 장착할 수 있습니다."
