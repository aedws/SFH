[gd_resource type="Resource" script_class="EquipmentArmorDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://game/features/equipment/armor_definition.gd" id="1_armor"]
[ext_resource type="Script" path="res://game/features/equipment/stat_modifier.gd" id="2_modifier"]
[ext_resource type="Script" path="res://game/features/equipment/equipment_fixed_option.gd" id="3_option"]

[sub_resource type="Resource" id="MaxHealth"]
script = ExtResource("2_modifier")
stat_id = &"max_health"
operation = 0
amount = 25.0

[sub_resource type="Resource" id="Defense"]
script = ExtResource("2_modifier")
stat_id = &"defense"
operation = 0
amount = 3.0

[sub_resource type="Resource" id="FixedOption"]
script = ExtResource("3_option")
option_id = &"trauma_liner"
display_name = "충격 흡수 내피"
target_kind = 0
modifier_id = &"max_health"
operation = 0
amount = 10.0
description = "레벨과 모듈 보정 없이 최대 체력 10을 고정 부여합니다."

[resource]
script = ExtResource("1_armor")
armor_id = &"tactical_vest"
display_name = "전술 방탄복"
slot_id = &"body"
maximum_level = 4
module_slot_limit = 3
module_cost_limit = 8
stat_modifiers = [SubResource("MaxHealth"), SubResource("Defense")]
fixed_options = [SubResource("FixedOption")]
description = "최대 체력과 고정 피해 감소를 올립니다."
