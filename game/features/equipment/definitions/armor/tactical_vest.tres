[gd_resource type="Resource" script_class="EquipmentArmorDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://game/features/equipment/armor_definition.gd" id="armor"]
[ext_resource type="Script" path="res://game/features/equipment/stat_modifier.gd" id="stat"]
[ext_resource type="Script" path="res://game/features/equipment/equipment_fixed_option.gd" id="option"]

[sub_resource type="Resource" id="max_health"]
script = ExtResource("stat")
stat_id = &"max_health"
operation = 0
amount = 25.0

[sub_resource type="Resource" id="defense"]
script = ExtResource("stat")
stat_id = &"defense"
operation = 0
amount = 3.0

[sub_resource type="Resource" id="fixed"]
script = ExtResource("option")
option_id = &"trauma_liner"
display_name = "충격 흡수 내피"
target_kind = 0
modifier_id = &"max_health"
operation = 0
amount = 10.0


[resource]
script = ExtResource("armor")
armor_id = &"tactical_vest"
display_name = "전술 방탄복"
slot_id = &"body"
maximum_level = 4
module_slot_limit = 3
module_cost_limit = 8
stat_modifiers = [SubResource("max_health"), SubResource("defense")]
fixed_options = [SubResource("fixed")]
description = "최대 체력과 고정 피해 감소를 올리는 신체 방어구 · 고정 옵션 충격 흡수 내피: 10"
