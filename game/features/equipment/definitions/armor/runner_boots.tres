[gd_resource type="Resource" script_class="EquipmentArmorDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://game/features/equipment/armor_definition.gd" id="armor"]
[ext_resource type="Script" path="res://game/features/equipment/stat_modifier.gd" id="stat"]
[ext_resource type="Script" path="res://game/features/equipment/equipment_fixed_option.gd" id="option"]

[sub_resource type="Resource" id="movement_speed"]
script = ExtResource("stat")
stat_id = &"movement_speed"
operation = 0
amount = 20.0

[sub_resource type="Resource" id="fixed"]
script = ExtResource("option")
option_id = &"responsive_sole"
display_name = "반응형 전술 밑창"
target_kind = 0
modifier_id = &"movement_speed"
operation = 0
amount = 12.0


[resource]
script = ExtResource("armor")
armor_id = &"runner_boots"
display_name = "기동 전투화"
slot_id = &"feet"
maximum_level = 3
module_slot_limit = 2
module_cost_limit = 5
stat_modifiers = [SubResource("movement_speed")]
fixed_options = [SubResource("fixed")]
description = "이동 속도를 올리는 범용 전투화 · 고정 옵션 반응형 전술 밑창: 12"
