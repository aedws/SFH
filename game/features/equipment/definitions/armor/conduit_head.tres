[gd_resource type="Resource" script_class="EquipmentArmorDefinition" load_steps=8 format=3]

[ext_resource type="Script" path="res://game/features/equipment/armor_definition.gd" id="armor"]
[ext_resource type="Script" path="res://game/features/equipment/stat_modifier.gd" id="stat"]
[ext_resource type="Script" path="res://game/features/equipment/equipment_fixed_option.gd" id="option"]
[ext_resource type="Resource" path="res://game/features/equipment/definitions/armor_sets/conduit.tres" id="set"]

[sub_resource type="Resource" id="max_health"]
script = ExtResource("stat")
stat_id = &"max_health"
operation = 0
amount = 6.0

[sub_resource type="Resource" id="defense"]
script = ExtResource("stat")
stat_id = &"defense"
operation = 0
amount = 0.5

[sub_resource type="Resource" id="fixed"]
script = ExtResource("option")
option_id = &"conduit_head_lining"
display_name = "축전 내피"
target_kind = 0
modifier_id = &"max_health"
operation = 0
amount = 3.0


[resource]
script = ExtResource("armor")
armor_id = &"conduit_head"
display_name = "축전자 헬멧"
slot_id = &"head"
maximum_level = 3
module_slot_limit = 2
module_cost_limit = 6
stat_modifiers = [SubResource("max_health"), SubResource("defense")]
fixed_options = [SubResource("fixed")]
armor_set = ExtResource("set")
description = "축전자 세트 · 같은 세트 2/4부위 보너스 · 수치 임시 · 고정 옵션 축전 내피: 3 · 2세트 장착 스킬 쿨타임 10% 감소 / 4세트 장착 스킬 피해 +20%"
