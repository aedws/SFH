{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "sfh-dev-wiki",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-09-02",
  "r2_buckets": [
    {
      "binding": "WIKI_AUTH",
      "bucket_name": "sfh-wiki-auth"
    }
  ],
  "vars": {
    "SESSION_TTL_SECONDS": "28800"
  }
}
