{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "sfh-game",
  "main": "worker/src/index.mjs",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "sfh-game-artifacts"
    }
  ],
  "vars": {
    "RELEASE_PREFIX": "game/releases/local",
    "DOWNLOAD_PREFIX": "downloads",
    "RELEASE_VERSION": "v0.1.0",
    "BUILD_COMMIT": "local"
  }
}
